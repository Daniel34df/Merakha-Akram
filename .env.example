# Bureau du Courrier — configuration du serveur.
# Copiez ce fichier sous le nom « .env » à la racine du projet et remplissez-le.
# Le fichier .env n'est jamais versionné (voir .gitignore).

# --- Serveur web ---
PORT=3000
HOST=0.0.0.0

# Emplacement du registre (fichier JSON créé automatiquement).
DB_FILE=./data/db.json

# --- Envoi automatique des courriels (facultatif) ---
# Sans ces variables, l'application fonctionne quand même : le bouton
# « Envoyer la notification » ouvre le logiciel de courriel de l'employé·e.
#
# Exécutez d'abord « npm install » pour installer nodemailer.
SMTP_HOST=smtp.exemple.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=courrier@exemple.com
SMTP_PASS=mot-de-passe-ou-jeton-applicatif
# Expéditeur par défaut. Le champ « De » des Réglages le remplace quand il est
# renseigné — mais beaucoup de fournisseurs SMTP refusent un expéditeur qui ne
# correspond pas au compte authentifié ci-dessus.
MAIL_FROM=Bureau du Courrier <courrier@exemple.com>

# Mode essai : les courriels ne partent pas, ils sont seulement affichés dans la
# console du serveur. Pratique pour une démonstration ou un test d'intégration.
MAIL_DRY_RUN=false

# Relances automatiques des courriers non récupérés, en jours.
# Vide ou 0 : aucune relance automatique (le bouton « Relancer » reste
# disponible dans l'historique). 7 = relance une semaine après la notification.
REMINDER_DAYS=

# --- Comptes (facultatif) ---
# Clé de chiffrement des secrets enregistrés (jetons Google, mots de passe
# d'application). Sans elle, une clé est créée dans data/secret.key au premier
# démarrage. À sauvegarder avec le registre, à ne jamais publier.
APP_SECRET=

# Vérification de l'adresse à l'inscription : un code à six chiffres est envoyé
# par courriel. Vide = active dès que SMTP est configuré. true = exigée (refuse
# l'inscription sans SMTP). false = désactivée.
VERIFY_EMAIL=

# Ferme les inscriptions une fois l'équipe créée : plus aucun compte ne peut
# être ajouté depuis l'écran de connexion.
SIGNUP_CLOSED=false

# --- Connexion de la boîte Gmail des employé·es (facultatif) ---
# Permet à chacun·e d'autoriser l'application depuis l'écran de Google, sans
# communiquer de mot de passe. Voir docs/connexion-boite-mail.md pour créer ces
# identifiants dans la console Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
